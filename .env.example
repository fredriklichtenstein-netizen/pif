# Supabase project a build talks to. Leave both unset for a PRODUCTION build.
# Staging build (Supabase branch; the ref changes if the branch is recreated):
# VITE_SUPABASE_URL=https://epxqddygoarwxmbshvvx.supabase.co
# VITE_SUPABASE_PUBLISHABLE_KEY=<staging branch anon key>

# Origin of shared item links (served by workers/share). Unset = production's
# app.pif.community. Staging: https://share-staging.pif.today
# VITE_SHARE_ORIGIN=
