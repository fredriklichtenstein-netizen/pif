# Cloudflare Pages response headers (mirrors what Lovable's hosting sent).
/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Referrer-Policy: strict-origin-when-cross-origin
  X-Content-Type-Options: nosniff

# Polled by the app to detect a newer build; must never be cached.
/version.json
  Cache-Control: no-store

# Content-hashed by Vite, but NOT immutable: Cloudflare Pages answers a
# missing /assets/ file with index.html (200, text/html), and this header
# would make browsers keep that HTML for a year in place of the script
# ("Kunde inte ladda sidan" on every reload, hit on staging 2026-11-20 after
# a deploy). One hour bounds the damage; real files then revalidate (304).
/assets/*
  Cache-Control: public, max-age=3600

# App link association files (iOS Universal Links / Android App Links). The
# Apple file has no extension, so its type must be set here; both must be
# served directly, never redirected.
/.well-known/apple-app-site-association
  Content-Type: application/json
/.well-known/assetlinks.json
  Content-Type: application/json

# Minimum app version (src/native/minVersion.ts). Read by the native apps from
# capacitor://localhost / https://localhost, so it needs CORS; never cached, so
# raising the minimum takes effect at once.
/app-version.json
  Content-Type: application/json
  Cache-Control: no-store
  Access-Control-Allow-Origin: *
